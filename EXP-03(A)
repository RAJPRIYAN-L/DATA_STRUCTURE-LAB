class Stack:
    def __init__(self):
        self.stack=[]
    def push(self,item):
        self.stack.append(item)
        print(f"{item} PUSHED TO THE STACK")

    def pop(self):
        if self.is_empty():
            return "STACK UNDERFLOW"
        return self.stack.pop()
    
    def peek(self):
        if self.is_empty():
            return "STACK IS EMPTY"
        return self.stack[-1]
    
    def is_empty(self):
        return len(self.stack)==0

    def size(self):
        return len(self.stack)
    
    def display(self):
        print("STACK ELEMENTS :",self.stack)


book=Stack()
while True:
        print("""
          1.PUSH A BOOK INTO STACK
          2.POP A BOOK INTO STACK
          3.PEEKING
          4.CHECK WHETHER THE STACK IS EMPTY
          5.SIZE OF THE STACK
          6.DISPLAY THE STACK
          7.EXIT""")

        choice = input("Enter your choice: ").strip()
        if choice == "1":
            data = input("ENTER THE BOOK NAME TO PUSH: ")
            book.push(data)

        elif choice == "2":
            po=book.pop()
            print(po,"BOOK REMOVED")

        elif choice == "3":
            pe=book.peek()
            print(pe)

        elif choice == "4":
            emp=book.is_empty()
            print(emp)

        elif choice == "5":
            s=book.size()
            print(s)

        elif choice == "6":
            d=book.display()
            print(d)

        elif choice == "7":
            print("EXITING THE STACK")
            break
        else:
            print("INVALID INPUT")
            break
